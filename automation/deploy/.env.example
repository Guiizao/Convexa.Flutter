# Copie para .env (cp .env.example .env) e preencha. O .env NUNCA vai para o git.
# Os segredos são preenchidos pelo ./gerar-segredos.sh (cria o .env a partir deste arquivo)

# Domínio: o DNS de api., auto., n8n. e painel. deve apontar para o IP deste servidor
DOMAIN=seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# Onde está o clone da ConvexaAPI (repositório do Gabriel), relativo a esta pasta
CONVEXA_API_DIR=../../../convexaapi

# --- segredos (gerados pelo gerar-segredos.sh) ---
POSTGRES_PASSWORD=
JWT_SECRET=
INTERNAL_API_KEY=
CREDENTIALS_ENCRYPTION_KEY=
AUTOMACAO_KEY=
ENCRYPTION_KEY=
N8N_ENCRYPTION_KEY=
WHATSAPP_VERIFY_TOKEN=

# --- e-mail de recuperação de senha (obrigatório em produção na ConvexaAPI) ---
RESEND_API_KEY=
MAIL_FROM=Convexa <nao-responda@seudominio.com.br>

# --- WhatsApp: versão da Graph API (confira a atual no painel da Meta, em "Configuração da API") ---
GRAPH_API_VERSION=v24.0

# --- opcionais ---
# IA para entender texto livre e ler comprovantes (console.anthropic.com)
ANTHROPIC_API_KEY=
# Google Agenda (console.cloud.google.com → Credenciais → ID do cliente OAuth, tipo "Aplicativo da Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Alexa (developer.amazon.com → sua skill → "Skill ID")
ALEXA_SKILL_ID=
