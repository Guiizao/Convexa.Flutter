            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "token-da-meta-m-dia--17",
      "name": "Token da Meta (mídia)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CONVEXA_API_URL }}/internal/integrations/by-phone-number-id/{{ $json.phoneNumberId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "cvxInternalKey01",
          "name": "Convexa API (chave interna)"
        }
      }
    },
    {
      "id": "baixar-m-dia-18",
      "name": "Baixar mídia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Comprovante do cliente: pega a URL na Graph API e baixa o arquivo (até 10 MB)\nconst prep = $('Preparar').first().json;\nconst token = $input.first().json.metaAccessToken;\nconst media = {};\nfor (const id of prep.mediaIds) {\n  const info = await this.helpers.httpRequest({ method: 'GET', url: `${$env.GRAPH_API_BASE}/${$env.GRAPH_API_VERSION}/${id}`, headers: { Authorization: 'Bearer ' + token }, json: true });\n  if ((info.file_size ?? 0) > 10 * 1024 * 1024) continue;\n  const file = await this.helpers.httpRequest({ method: 'GET', url: info.url, headers: { Authorization: 'Bearer ' + token }, encoding: 'arraybuffer' });\n  media[id] = { mimeType: info.mime_type, base64: Buffer.from(file).toString('base64') };\n}\nreturn [{ json: { ...prep, media } }];"
      }
    },
    {
      "id": "c-rebro-convexa-automacao--19",
      "name": "Cérebro (convexa-automacao)",
