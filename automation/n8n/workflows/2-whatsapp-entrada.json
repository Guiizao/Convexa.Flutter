        "url": "={{ $env.AUTOMACAO_URL }}/v1/whatsapp/inbound",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ payload: null, rawBody: $json.rawBody, signature: $json.signature, media: $json.media ?? {} }) }}",
        "options": {
          "timeout": 45000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
