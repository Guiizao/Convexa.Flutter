    {
      "id": "preparar-15",
      "name": "Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Corpo cru (para conferir a assinatura da Meta) e mídias a baixar\nconst item = $input.first();\nlet rawBody;\nif (item.binary?.data) {\n  rawBody = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n} else {\n  rawBody = JSON.stringify(item.json.body);\n}\nconst payload = JSON.parse(rawBody);\nconst mediaIds = [];\nlet phoneNumberId = null;\nfor (const e of payload.entry ?? []) for (const ch of e.changes ?? []) {\n  phoneNumberId = ch.value?.metadata?.phone_number_id ?? phoneNumberId;\n  for (const m of ch.value?.messages ?? []) {\n    const media = m.image ?? m.document;\n    if (media?.id) mediaIds.push(media.id);\n  }\n}\nconst h = item.json.headers ?? {};\nreturn [{ json: { rawBody, signature: h['x-hub-signature-256'] ?? null, phoneNumberId, mediaIds, hasMessages: (rawBody.includes('\"messages\"')) } }];"
      }
    },
    {
      "id": "tem-foto-arquivo--16",
      "name": "Tem foto/arquivo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
